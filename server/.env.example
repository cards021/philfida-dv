# Copy to .env and fill in. Same variable names as the original PHP backend.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=voucher_tracking
DB_USER=root
DB_PASS=
# Set to "true" when your MySQL provider requires TLS (PlanetScale, Aiven, ...).
DB_SSL=false
# Long random string used to sign session cookies. REQUIRED in production.
SESSION_SECRET=change-me-to-a-long-random-string
# Port the API listens on. The frontend is served from ../client/dist when built.
PORT=3000
# Set to "true" when serving traffic directly over HTTPS (also auto-enabled
# when the x-forwarded-proto header says https behind a proxy).
COOKIE_SECURE=false
