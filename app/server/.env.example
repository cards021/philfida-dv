# Copy to .env and fill in. Never commit .env to source control.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=voucher_tracking
DB_USER=root
DB_PASS=
# Set to "true" when your MySQL provider requires TLS (PlanetScale, Aiven, ...).
DB_SSL=false
# Long random string used to sign session cookies. REQUIRED in production.
SESSION_SECRET=change-me-to-a-long-random-string
# Port the API listens on (ignored on Vercel/serverless).
PORT=3000
# Seed admin (used by `npm run seed` only):
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
ADMIN_NAME=System Administrator
